# Copy to .env and fill in. Real environment variables always win over this file.
# Blank values are skipped, so leaving a line empty is safe. Never commit .env.
# Every variable below is read by the code; docs/ENVIRONMENT.md explains each.

# Polling interval
SIDELINE_POLL_SECONDS=30

# The server
SIDELINE_HOST=127.0.0.1
SIDELINE_PORT=8765
SIDELINE_LOG=INFO
# A folder of daily log files (a text log, and one JSON line per call). Git-ignored. off disables it.
SIDELINE_LOG_DIR=logs
SIDELINE_LOG_KEEP_DAYS=14
SIDELINE_ALLOWED_ORIGINS=localhost,127.0.0.1

# AWS: Bedrock (the language), Polly (the voice), DynamoDB (listener state).
# IAM access keys: they cover Bedrock, Polly and DynamoDB.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SIDELINE_BEDROCK=auto
SIDELINE_BEDROCK_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
SIDELINE_STATE=auto
SIDELINE_TABLE=sideline

# Voice, for the simulator.
# STT: Groq Whisper Large v3 Turbo (~200ms) with GROQ_API_KEY, or AWS Bedrock (Voxtral / Nova Sonic).
# With GROQ_API_KEY set and SIDELINE_STT=auto, Groq leads automatically.
GROQ_API_KEY=
SIDELINE_STT=auto

# TTS: Speech out provider. Options: auto, browser (<15ms), cartesia (~60ms), elevenlabs (~75ms), polly.
SIDELINE_TTS=auto
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
SIDELINE_POLLY_VOICE=Amy
SIDELINE_POLLY_ENGINE=generative
SIDELINE_LIVE_CAPTION=browser

# Match preview: the weather at the ground, from Open-Meteo (no key). off keeps the city off the network.
SIDELINE_WEATHER=on
