# Copy to .env. Everything here is optional: the MCP server starts with no setup and needs no key for its data.
# Real environment variables always win over this file; blank values are skipped. Never commit .env.
# Every other setting, with its default, is in docs/ENVIRONMENT.md.

# AWS: Bedrock wording and the simulator's agent, Polly voice, DynamoDB state. IAM access keys cover all three.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Hosting: before the server listens beyond this machine, set a token (16+ characters) and its bind address.
# Clients then send: Authorization: Bearer <token>
SIDELINE_HOST=127.0.0.1
SIDELINE_AUTH_TOKEN=
