# Copy to .env and fill in. Real environment variables always win over this file.
# Blank values are skipped, so leaving a line empty is safe. Never commit .env.
# Every variable below is read by the code; docs/ENVIRONMENT.md explains each.

# The live football feed. The server will not start without a key: there is no recorded or demo data.
# Free key: https://dashboard.api-football.com
SIDELINE_FOOTBALL_KEY=
SIDELINE_POLL_SECONDS=60

# The server
SIDELINE_HOST=127.0.0.1
SIDELINE_PORT=8765
SIDELINE_LOG=INFO
SIDELINE_ALLOWED_ORIGINS=localhost,127.0.0.1

# AWS: Bedrock (the language), Polly (the voice), DynamoDB (listener state).
# Use IAM keys, or a profile; a Bedrock API key alone covers Bedrock only.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_PROFILE=
AWS_BEARER_TOKEN_BEDROCK=
SIDELINE_BEDROCK=auto
SIDELINE_BEDROCK_MODEL=amazon.nova-micro-v1:0
SIDELINE_STATE=auto
SIDELINE_TABLE=sideline

# Voice, for the simulator. Blank GROQ_API_KEY means nothing leaves AWS (see docs/SPEECH.md).
SIDELINE_POLLY_VOICE=Amy
SIDELINE_STT=auto
GROQ_API_KEY=
SIDELINE_LIVE_CAPTION=browser
