# Copy to .env and fill in. Nothing here is commented out: every line is
# live, and a blank value is simply skipped, so leaving a line empty is safe.
#
# PRECEDENCE: a real environment variable (export, container, App Runner)
# ALWAYS beats this file, and this file beats the built-in default.
# So the priority order is: environment > .env > default.
#
# .env is git-ignored. Never commit a filled-in copy.
#
# "auto" integrations switch ON by themselves when their credentials are
# present, and stay off (the server still runs) when they are not.

# ------------------------------------------------------------- MODE
# live = Real API data, Bedrock invoked on human asks (no prefill).
# demo = Replays local match with precomputed catch-up templates.
SIDELINE_MODE=live

# ---------------------------------------------------------------- AWS
# Credentials. Fill the first two to unlock Bedrock, DynamoDB, Polly and
# Transcribe. AWS_SESSION_TOKEN only for temporary credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# auto = on when AWS credentials are present. on / off to force.
SIDELINE_BEDROCK=auto
# Model or inference-profile id your account can call. `make aws-check`
# lists them; the default may not be enabled on your account.
SIDELINE_BEDROCK_MODEL=anthropic.claude-3-5-haiku-20241022-v1:0
# Seconds. 3.0 favours the model's catch-up; 0.4 stays inside Alexa+'s
# 500 ms target by falling back to templates (docs/BEDROCK.md).
SIDELINE_BEDROCK_TIMEOUT=3.0
SIDELINE_WORD_TARGET=45
# cached = the model writes catch-ups in the background, asking is a lookup.
# live = the model is called when the listener asks (slower).
SIDELINE_CATCHUP_MODE=cached

# auto = DynamoDB when AWS credentials are present AND the table answers
# (`make create-table`), otherwise memory with a warning. memory / dynamo to force.
SIDELINE_STATE=auto
SIDELINE_TABLE=sideline
# DynamoDB Local, for free offline testing, e.g. http://localhost:8000
SIDELINE_DYNAMO_ENDPOINT=

# CloudWatch metrics as log lines (on in App Runner).
SIDELINE_EMF=off

# -------------------------------------------------- live football data
# auto = live API-Football when a key (or secret) is present, else the
# recorded real match. replay / apifootball to force.
SIDELINE_PROVIDER=auto
SIDELINE_FOOTBALL_KEY=
# Or keep the key in Secrets Manager (name or ARN), fetched at startup.
# SIDELINE_FOOTBALL_KEY above wins if both are set.
SIDELINE_FOOTBALL_SECRET=
SIDELINE_FOOTBALL_BASE=https://v3.football.api-sports.io
# Raise to 60 on a free plan (about 100 requests a day).
SIDELINE_POLL_SECONDS=15

# ---------------------------------------- authentication (Alexa+ account linking)
# off = single shared listener (fine for a demo). required = verify bearer
# tokens; then ISSUER, PUBLIC_URL and JWKS_URL (or HS256_SECRET) are needed.
SIDELINE_AUTH=off
SIDELINE_AUTH_ISSUER=
# Canonical https URL of this server's /mcp, exactly as in the add-on manifest.
SIDELINE_PUBLIC_URL=
SIDELINE_AUTH_JWKS_URL=
SIDELINE_AUTH_SCOPES=
SIDELINE_AUTH_AUDIENCE=
SIDELINE_AUTH_HS256_SECRET=

# ----------------------------------------------------- server and voice
SIDELINE_HOST=127.0.0.1
SIDELINE_PORT=8765
SIDELINE_LOG=INFO
SIDELINE_ALLOWED_ORIGINS=localhost,127.0.0.1
SIDELINE_POLLY_VOICE=Amy
SIDELINE_POLLY_ENGINE=neural
SIDELINE_STT=auto
SIDELINE_TRANSCRIBE_LANG=en-GB
