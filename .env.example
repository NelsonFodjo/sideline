# Copy to .env and export, or set in your shell. Every value is optional:
# with nothing set, `python3 -m sideline` runs against the recorded match.
# Never put a real key in this file or commit a filled-in copy.

# --- server
SIDELINE_HOST=127.0.0.1
SIDELINE_PORT=8765
SIDELINE_LOG=INFO
SIDELINE_ALLOWED_ORIGINS=localhost,127.0.0.1

# --- data: replay (default, no key) | apifootball (needs a key)
SIDELINE_PROVIDER=replay
SIDELINE_REPLAY=data/replay/arsenal-spurs.json
SIDELINE_REPLAY_SPEED=1.0
SIDELINE_REPLAY_START=0
SIDELINE_POLL_SECONDS=15
SIDELINE_FOOTBALL_KEY=
SIDELINE_FOOTBALL_BASE=https://v3.football.api-sports.io

# --- AWS
AWS_REGION=us-east-1
SIDELINE_BEDROCK=off
SIDELINE_BEDROCK_MODEL=anthropic.claude-3-5-haiku-20241022-v1:0
SIDELINE_WORD_TARGET=45

# --- state: memory (default) | dynamo
SIDELINE_STATE=memory
SIDELINE_TABLE=sideline
SIDELINE_DYNAMO_ENDPOINT=

# --- simulator voice
SIDELINE_POLLY_VOICE=Amy
SIDELINE_POLLY_ENGINE=neural
SIDELINE_STT=auto
SIDELINE_TRANSCRIBE_LANG=en-GB
